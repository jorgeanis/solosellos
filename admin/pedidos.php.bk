    th { background-color: #f2f2f2; }
    .preview-wrapper-container { 
        transform: scale(0.6); 
        transform-origin: top left; 
        width: 316px; /* 190px / 0.6 */
        height: 133px; /* 80px / 0.6 */
    }
    .link-icon { font-size: 24px; text-decoration: none; }
</style>

<h2>Pedidos Recibidos</h2>

<!-- Formulario de filtros (simplificado para claridad) -->
<form method="GET" style="margin-bottom: 20px; display: flex; gap: 15px; align-items: center;">
    <select name="estado" onchange="this.form.submit()">
        <option value="todos" <?= $filtro === 'todos' ? 'selected' : '' ?>>Todos</option>
        <option value="En preparación" <?= $filtro === 'En preparación' ? 'selected' : '' ?>>En preparación</option>
        <option value="Entregado" <?= $filtro === 'Entregado' ? 'selected' : '' ?>>Entregado</option>
        <option value="Pagado" <?= $filtro === 'Pagado' ? 'selected' : '' ?>>Pagado</option>
    </select>
    <input type="text" name="buscar" placeholder="Buscar por nombre o texto..." value="<?= htmlspecialchars($busqueda) ?>">
    <input type="date" name="fecha" value="<?= htmlspecialchars($fecha) ?>">
    <button type="submit">Buscar</button>
    <a href="pedidos.php">Limpiar</a>
</form>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Contacto</th>
                <th>Modelo</th>
                <th>Vista Previa del Sello</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th>Enlace</th>
            </tr>
        </thead>
        <tbody>
        <?php foreach ($orders as $order): ?>
            <?php
            // Preparar datos de la plantilla para el renderizador
            $plantilla_data = [
                'id' => $order['template_id'],
                'linea1' => ['texto' => $order['text_line1'], 'fuente' => $order['fuente_linea_1'], 'tamano' => $order['tamano_linea_1'], 'negrita' => !empty($order['bold_linea_1']), 'alineacion' => $order['alineacion_linea_1'], 'margen' => $order['margen_top_linea_1']],
                'linea2' => ['texto' => $order['text_line2'], 'fuente' => $order['fuente_linea_2'], 'tamano' => $order['tamano_linea_2'], 'negrita' => !empty($order['bold_linea_2']), 'alineacion' => $order['alineacion_linea_2'], 'margen' => $order['margen_top_linea_2']],
                'linea3' => ['texto' => $order['text_line3'], 'fuente' => $order['fuente_linea_3'], 'tamano' => $order['tamano_linea_3'], 'negrita' => !empty($order['bold_linea_3']), 'alineacion' => $order['alineacion_linea_3'], 'margen' => $order['margen_top_linea_3']],
                'linea4' => ['texto' => $order['text_line4'], 'fuente' => $order['fuente_linea_4'], 'tamano' => $order['tamano_linea_4'], 'negrita' => !empty($order['bold_linea_4']), 'alineacion' => $order['alineacion_linea_4'], 'margen' => $order['margen_top_linea_4']]
            ];
            ?>
            <tr>
                <td><?= $order['id'] ?></td>
                <td><?= htmlspecialchars($order['name'] . ' ' . $order['lastname']) ?></td>
                <td><a href="https://wa.me/<?= preg_replace('/[^0-9]/', '', $order['whatsapp']) ?>" target="_blank">📱</a></td>
                <td><img src="../assets/images/<?= htmlspecialchars($order['model_image']) ?>" style="max-height: 50px;"></td>
                <td>
                    <div class="preview-wrapper-container">
                        <div class="plantilla-preview-wrapper" 
                             id="preview-order-<?= $order['id'] ?>"
                             data-template-data='<?= htmlspecialchars(json_encode($plantilla_data), ENT_QUOTES, 'UTF-8') ?>'>
                            <?php include 'includes/_plantilla_preview.php'; ?>
                        </div>
                    </div>
                </td>
                <td>
                    <form method="POST" style="margin:0;">
                        <input type="hidden" name="pedido_id" value="<?= $order['id'] ?>">
                        <select name="nuevo_estado" onchange="this.form.submit()">
                            <option <?= $order['status'] === 'En preparación' ? 'selected' : '' ?>>En preparación</option>
                            <option <?= $order['status'] === 'Entregado' ? 'selected' : '' ?>>Entregado</option>
                            <option <?= $order['status'] === 'Pagado' ? 'selected' : '' ?>>Pagado</option>
                        </select>
                    </form>
                </td>
                <td><?= date('d/m/Y H:i', strtotime($order['created_at'])) ?></td>
                <td>
                    <a href="../public/thanks.php?order=<?= htmlspecialchars($order['order_code']) ?>&u=<?= htmlspecialchars($order['link_code']) ?>" 
                       target="_blank" 
                       class="link-icon" 
                       title="Ver página de agradecimiento">🔗</a>
                </td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>

<!-- JS del Renderizador -->
<script src="../assets/js/plantilla-renderer.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    // Renderizar todas las vistas previas de los pedidos
    document.querySelectorAll('.plantilla-preview-wrapper[data-template-data]').forEach(previewWrapper => {
        const templateDataAttr = previewWrapper.getAttribute('data-template-data');
        if (templateDataAttr) {
            try {
                const templateData = JSON.parse(templateDataAttr);
                const previewContainer = previewWrapper.querySelector('.plantilla-preview-container');
                if (previewContainer) {
                    window.renderizarPlantilla(previewContainer, templateData);
                }
            } catch (e) {
                console.error('Error al renderizar vista previa del pedido:', previewWrapper.id, e);
            }
        }
    });
});
</script>

<?php require_once 'includes/footer.php'; ?>