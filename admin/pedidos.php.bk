<?php
ini_set('display_errors', 1);
error_reporting(E_ALL);
require_once 'includes/auth.php';
require_once 'includes/db.php';

// --- MANEJO DE FILTROS Y BÚSQUEDA ---
$filtro = $_GET['estado'] ?? 'todos';
$busqueda = $_GET['buscar'] ?? '';
$fecha = $_GET['fecha'] ?? '';

$params = [$_SESSION['user']['id']];
$condiciones = "o.user_id = ?";

if ($filtro !== 'todos') {
    $condiciones .= " AND o.status = ?";
    $params[] = $filtro;
}
if (!empty($fecha)) {
    $condiciones .= " AND DATE(o.created_at) = ?";
    $params[] = $fecha;
}
if (!empty($busqueda)) {
    $condiciones .= " AND (o.name LIKE ? OR o.lastname LIKE ? OR o.text_line1 LIKE ? OR o.text_line2 LIKE ? OR o.text_line3 LIKE ? OR o.text_line4 LIKE ?)";
    $searchTerm = "%{$busqueda}%";
    for ($i = 0; $i < 6; $i++) $params[] = $searchTerm;
}

// --- CONSULTA PRINCIPAL ---
$sql = "
    SELECT 
        o.*, 
        u.whatsapp, u.link_code,
        m.image AS model_image,
        t.nombre AS template_name,
        t.fuente_linea_1, t.tamano_linea_1, t.bold_linea_1, t.alineacion_linea_1, t.margen_top_linea_1,
        t.fuente_linea_2, t.tamano_linea_2, t.bold_linea_2, t.alineacion_linea_2, t.margen_top_linea_2,
        t.fuente_linea_3, t.tamano_linea_3, t.bold_linea_3, t.alineacion_linea_3, t.margen_top_linea_3,
        t.fuente_linea_4, t.tamano_linea_4, t.bold_linea_4, t.alineacion_linea_4, t.margen_top_linea_4
    FROM orders o
    JOIN models m ON o.model_id = m.id
    JOIN users u ON o.user_id = u.id
    JOIN templates t ON o.template_id = t.id
    WHERE $condiciones 
    ORDER BY o.id DESC
";
$stmt = $pdo->prepare($sql);
$stmt->execute($params);
$orders = $stmt->fetchAll(PDO::FETCH_ASSOC);

// --- CARGA DE FUENTES ---
$fonts_to_load = [];
foreach ($orders as $order) {
    for ($i = 1; $i <= 4; $i++) {
        if (!empty($order["fuente_linea_$i"])) {
            $fonts_to_load[] = $order["fuente_linea_$i"];
        }
    }
}
$fonts_to_load = array_unique($fonts_to_load);

// --- MANEJO DE POST PARA ACTUALIZAR ESTADO ---
if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST['pedido_id'], $_POST['nuevo_estado'])) {
    $stmt = $pdo->prepare("UPDATE orders SET status = ? WHERE id = ? AND user_id = ?");
    $stmt->execute([$_POST['nuevo_estado'], $_POST['pedido_id'], $_SESSION['user']['id']]);
    header("Location: pedidos.php?" . http_build_query($_GET));
    exit;
}

require_once 'includes/header.php';
?>

<!-- CSS y Fuentes -->
<link rel="stylesheet" href="../assets/css/plantilla-preview.css">
<?php foreach ($fonts_to_load as $font): ?>
<link href="https://fonts.googleapis.com/css2?family=<?= str_replace(' ', '+', $font) ?>&display=swap" rel="stylesheet">
<?php endforeach; ?>

<style>
    /* Estilos para la página de pedidos (simplificados) */
